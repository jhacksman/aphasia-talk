# Copy to .env and adjust for your deployment.

# Set to false on the DGX Spark to use real vLLM + whisper.cpp.
# Leave true for development without a GPU (fabricated sentences/transcripts).
MOCK_INFERENCE=true

VLLM_URL=http://vllm:8000
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
WHISPER_URL=http://whisper:8001

# DATABASE_PATH=/app/data/aphasia_talk.db
# REQUEST_TIMEOUT=30
# MAX_SENTENCES=8
