# Copy to .env on the Spark. Models are config — change them here, not in code.

# Where spark/setup.sh downloaded the weights.
MODELS_DIR=/home/user/models

# The LLM served by vLLM. If you swap it, run spark/setup.sh with
# LLM_REPO=<new repo> first, and re-run spark/smoke_test.sh after.
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
# Parser matching the model family ("qwen3" for Qwen3.x; change with model).
VLLM_REASONING_PARSER=qwen3

# Speech-to-text.
WHISPER_IMAGE=whisper-cpp-server:sm121
WHISPER_MODEL=ggml-large-v3-turbo.bin

# false on the Spark = real inference. true = fabricated output for GPU-less dev.
MOCK_INFERENCE=false
