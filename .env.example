# Copy to .env on the Spark. Models are config — change them here, not in code.

# Where spark/setup.sh downloaded the weights.
MODELS_DIR=/home/user/models

# The LLM served by vLLM. If you swap it, run spark/setup.sh with
# LLM_REPO=<new repo> first, and re-run spark/smoke_test.sh after.
# Serve by in-container path (/models/<dir>) so vLLM uses the weights
# setup.sh downloaded instead of re-pulling from the Hub.
VLLM_MODEL=/models/Qwen3.6-35B-A3B-NVFP4
# GB10/Spark: the upstream vllm-openai:cu130-nightly tag went stale in
# April 2026 and cannot load ModelOpt NVFP4 MoE checkpoints. The AEON
# image is vLLM built for GB10 (sm_121a) with working NVFP4 kernels.
# Pin a digest once verified (docker images --digests).
VLLM_IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:latest
# Parser matching the model family ("qwen3" for Qwen3.x; change with model).
VLLM_REASONING_PARSER=qwen3

# Speech-to-text.
WHISPER_IMAGE=whisper-cpp-server:sm121
WHISPER_MODEL=ggml-large-v3-turbo.bin

# Voice-cloning TTS ("Her voice" option on the tablet). Base variant only —
# it's the one Qwen3-TTS variant that clones. Image built on the Spark:
#   docker build -t aphasia-tts:qwen3 spark/tts
TTS_IMAGE=aphasia-tts:qwen3
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# false on the Spark = real inference. true = fabricated output for GPU-less dev.
MOCK_INFERENCE=false
